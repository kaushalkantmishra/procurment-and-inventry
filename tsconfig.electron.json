{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "electron/**/*",
    "backend/**/*",
    "config/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "backend/drizzle"
  ]
}
